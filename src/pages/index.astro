---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import Messages from "@components/Messages.astro";
import { actions } from "astro:actions";

export const prerender = false;

const result = Astro.getActionResult(actions.sendMessage);
if (result?.data) {
  return Astro.redirect(`${Astro.originPathname}?success=true`);
} else if (result?.error) {
  return Astro.redirect(`${Astro.originPathname}?error=true`);
}
---

<BaseLayout>
  <Hero />
  <Messages />
</BaseLayout>
