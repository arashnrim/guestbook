<style is:global>
  :root {
    --section-padding: 3em;

    --radius: 1em;
    --input-radius: calc(var(--radius) / 2);

    --body: clamp(1.125rem, 1.0739rem + 0.2273vw, 1.25rem);
    --subtitle: clamp(1.35rem, 1.2206rem + 0.575vw, 1.6663rem);
    --title: clamp(1.944rem, 1.5281rem + 1.8486vw, 2.9607rem);

    --sans:
      var(--font-general-sans), system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, "Open Sans",
      "Helvetica Neue", sans-serif;
    --mono: var(--font-jetbrains-mono), "Courier New", Courier, monospace;
  }

  @media screen and (min-width: 768px) {
    :root {
      --section-padding: 6em;
    }
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 2em;
    font-size: var(--body);
  }

  body {
    background-color: #0a0a0a;
    margin: 0;
  }

  * {
    color: #ffffff;
    font-family: var(--sans);
    font-weight: 500;
  }

  *::selection {
    background-color: #333;
  }

  .container {
    padding: calc(var(--section-padding) / 2) var(--section-padding);
    position: relative;
    overflow: hidden;
    border-top: 1px solid #1f1f1f;
  }

  p,
  span {
    max-width: 920px;
    line-height: 1.5;
  }

  a {
    text-decoration: none;
    border: 1px solid #ffffff;
    padding: 0 2.5px;
    font-weight: 600;
  }

  code {
    font-family: var(--mono);
    font-size: calc(var(--body) * 0.725);
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-weight: 700;
  }

  .subtitle {
    font-size: var(--subtitle);
    margin: 0;
  }

  .title {
    font-size: var(--title);
    margin: 0;
  }

  @media screen and (min-width: 1024px) {
    :root {
      --section-padding: 12em;
    }

    .container {
      padding: calc(var(--section-padding) / 3) var(--section-padding);
    }
  }
</style>
