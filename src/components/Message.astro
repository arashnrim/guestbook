---
import type { Message } from "@db/schema";

interface Props {
  message: Message;
}

const { message } = Astro.props;
---

<div class="message">
  <div class="message__info">
    <div class="message__person">
      <h2>{message.name}</h2>
      {
        message.link && (
          <a href={message.link} target="_blank" rel="noopener noreferrer">
            Website
          </a>
        )
      }
    </div>
    <p class="message__date">
      {
        new Date(message.date).toLocaleDateString("en-SG", {
          day: "2-digit",
          month: "short",
          year: "numeric",
        })
      }
    </p>
  </div>
  <div class="message__content">
    <p>{message.message}</p>
  </div>
  {
    message.response && (
      <div class="message__response">
        <h3>Arash's reply</h3>
        <p>{message.response}</p>
      </div>
    )
  }
</div>

<style>
  .message {
    padding: 2em;
    background-color: #0a0a0a;
    border: 3px solid #1f1f1f;
    border-radius: var(--radius);
  }

  .message__info {
    display: flex;
  }

  .message__person {
    flex-grow: 1;
  }

  .message__person > *,
  .message__response > * {
    margin: 0;
  }

  .message__person > a {
    font-size: calc(0.6 * var(--body));
  }

  .message__response {
    padding: 1em;
    border: 1px solid #1f1f1f;
    border-radius: var(--input-radius);
  }

  .message__response > h3 {
    font-size: unset;
  }

  .message__date {
    margin: 0;
    align-self: center;
    text-align: right;
  }
</style>
