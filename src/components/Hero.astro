---
import Form from "@components/Form.astro";
---

<section id="hero" class="container">
  <div id="hero__text">
    <h1>Thanks for stopping by!</h1>
    <p>
      Feel free to leave a message below. I'm all for exploring the internet, so
      I'd love to check out what you've made on your corner too — just drop a
      link in your message!
    </p>
  </div>

  <Form />
</section>

<style>
  #hero {
    border-bottom: 3px solid #1f1f1f;
    /* background:
      radial-gradient(#1f1f1f, 2.5px, transparent 3px) 0 0 / 50px 50px,
      linear-gradient(to bottom, #0a0a0a, transparent 500%); */
  }

  #hero__text {
    margin-bottom: 2em;
  }

  #hero__text > h1 {
    margin: 0;
  }
</style>
