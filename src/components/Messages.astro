---
import Message from "./Message.astro";
import type { Message as MessageType } from "@db/schema";
import { actions } from "astro:actions";

const { data, error } = await Astro.callAction(actions.getMessages, {});
const getTimestamp = (date: string | null) => {
  if (date === null) return 0;
  return new Date(date).getTime();
};
const sortedMessages = [...(data ?? [])].sort(
  (a, b) => getTimestamp(b.date) - getTimestamp(a.date),
);
---

<section id="messages" class="container">
  {
    sortedMessages.map((message) => (
      <Message message={message as MessageType} />
    ))
  }
</section>

<style>
  #messages {
    background:
      radial-gradient(#1f1f1f, 2.5px, transparent 3px) 0 0 / 50px 50px,
      linear-gradient(to bottom, #0a0a0a, transparent 500%);
    display: grid;
    gap: 1.5em;
    padding-left: calc(var(--section-padding) / 2);
    padding-right: calc(var(--section-padding) / 2);
  }

  @media screen and (min-width: 1024px) {
    #messages {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 1536px) {
    #messages {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
